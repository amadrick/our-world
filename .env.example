# Copy this file to .env.local and fill in what you need. Nothing here is
# required to run the app locally.

# OpenAI key for writing place summaries when you add a place.
# Without it, new places get a clearly marked placeholder you can edit.
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: which OpenAI model writes the summaries (default: gpt-5-mini).
OPENAI_MODEL=

# Password for /admin. Locally it defaults to "goldengate"; a deployed site
# keeps /admin locked until this is set.
ADMIN_PASSWORD=

# Optional: where places are stored (default: data/places.json).
PLACES_FILE=

# Optional: set to "offline" to use map tiles generated by
# `npm run tiles:offline` instead of OpenFreeMap (for networks that block it).
NEXT_PUBLIC_MAP_TILES=

# Optional: image model for `npm run images` (default: gpt-image-1).
OPENAI_IMAGE_MODEL=

# Draw place stills (facades and interiors only; food briefs are refused).
# PLACE_IMAGE_GENERATION=on
